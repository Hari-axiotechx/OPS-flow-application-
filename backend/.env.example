# Copy this file to .env for local (non-Docker) runs. When running via
# docker compose, these are already set in docker-compose.yml — you only
# need to edit the values there (or override with a .env next to it).

DATABASE_URL=postgresql+psycopg2://opsflow:opsflow@localhost:5432/opsflow

# Signs session tokens — set this to a long random string before you put
# this anywhere other than your laptop.
TOKEN_SECRET=change-me-before-deploying
TOKEN_TTL_HOURS=12
OTP_TTL_MINUTES=10

# Origins allowed to call this API (your frontend dev server / deployed URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First-run admin account, created automatically on first startup if no
# user with this email exists yet. Change the password after first login.
ADMIN_EMAIL=hariprasad.mylamuru@axiotechx.com
ADMIN_PASSWORD=Hari123!
ADMIN_NAME=Hariprasad Mylamuru

# Only emails ending in this domain may register a new account.
# Leave blank to allow any domain.
ALLOWED_EMAIL_DOMAIN=axiotechx.com


# ---------------------------------------------------------------------
# Outlook / Microsoft 365 e-mail
# ---------------------------------------------------------------------
# false = dry run: e-mails are only printed in the backend log.
# Microsoft 365 mail is sent through Microsoft Graph (not SMTP).
MAIL_PROVIDER=graph
# Every OPSFlow e-mail is sent from this address
MAIL_FROM_ADDRESS=no-reply@axiotechx.com
MAIL_FROM_NAME=OPSFlow
MAIL_TIMEZONE=Asia/Kolkata
# Link used by the "Review request in OPSFlow" button in e-mails
APP_BASE_URL=http://localhost:5173
# Roles copied on deployment requests and AWS issues
MAIL_CC_TEAM_ROLES=Developer,QA

# Optional legacy SMTP settings; unused when MAIL_PROVIDER=graph.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# A failed send is retried this many times (pause doubles each time)
MAIL_RETRIES=3
MAIL_RETRY_DELAY_SECONDS=2

# SMTP_SECURE=false -> STARTTLS (587); true -> implicit TLS (465)
SMTP_SECURE=false
# Do not switch to SMTP if Graph fails.
MAIL_FALLBACK_SMTP=false

# provider = graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=


# ---------------------------------------------------------------------
# Voice assistant: required for free-form questions, look-ups, and follow-ups.
# ---------------------------------------------------------------------
# Without a key, only commands understood by the built-in parser work.
ANTHROPIC_API_KEY=
VOICE_LLM_MODEL=claude-haiku-5-5

# Professional listening (recommended): get a free key at https://console.deepgram.com
# Much more accurate and faster than the browser recognizer. Empty = browser recognizer.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=en-IN
# browser (default, free) | cloud = Deepgram also hears "Hello Ops": much better from a distance / with a quiet voice.
STT_WAKE=browser
